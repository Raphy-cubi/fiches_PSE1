# ============================================================
#  Fiches PSE1 — Bilan complémentaire · v0.2
#  Fichier : .gitignore
#  Rôle    : Exclut les artefacts de compilation, les fichiers
#            d'éditeur et le dossier de doc local. PDFs de output/
#            suivis dans git pour partage rapide.
# ============================================================

# Documentation locale
/doc/

# LaTeX auxiliary files (root + sub-dirs)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.glg
*.glo
*.gls
*.idx
*.ilg
*.ind
*.ist
*.lof
*.log
*.lot
*.maf
*.mtc
*.mtc0
*.nav
*.nlo
*.out
*.pdfsync
*.ps
*.ptc
*.run.xml
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.upa
*.upb
*.vrb
*.xdv

# Build dir (PDF intermédiaires + tous les .aux/.log)
/build/
!/build/.gitkeep

# MiKTeX/TeX Live cache
*.fmt
*.dump

# Editor files (sauf settings.json partagé)
.vscode/*
!.vscode/settings.json
*.swp
*~
.DS_Store

# PDFs finaux : suivis dans git (output/*.pdf), .gitkeep conservé pour le dossier vide
